%% Component and deployment diagram
flowchart TB
  subgraph PC["User PC (Windows, Python 3.12)"]
    direction TB
    subgraph CL["Tkinter client (src/)"]
      M["main.py + navigate.py"] --> SC["screens/ (login, sign-up, event page)"]
      M --> WS["welcome/ (one home screen per role)"]
      SC --> PAY["payment.py + pricing.py"]
      WS --> PAY
      PAY --> PDF["booking_pdf.py"]
      SC --> API["api_client.py (requests)"]
      WS --> API
    end
    PDF --> DL[("Downloads folder (receipt PDF)")]
  end
  subgraph SRV["Server process (same machine, localhost)"]
    direction TB
    FL["server.py (Flask REST API, 127.0.0.1:5000)"] --> CORE["database_core.py (users, SSN, support, reports)"]
    FL --> EV["database_events.py (events, bookings, VAT, refunds, vehicles, cart, reviews)"]
    CORE --> DB[("users.db (SQLite)")]
    EV --> DB
    FL --> IMG[("event_images/*.jpg")]
  end
  API -- "HTTP + JSON" --> FL
  SEED["dummy_data.ps1"] -. "seeds" .-> DB
