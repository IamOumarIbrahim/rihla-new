%% Component class diagram: Accounts and Sign-in
classDiagram
  direction TB
  class LoginScreen {
    <<screens/login.py>>
    +show_login_screen(root, email, password)
    +handle_login()
    +set_demo(role)
  }
  class CreateAccountScreen {
    <<screens/create_account.py>>
    +show_create_account_screen(root)
    +verify_email()
    +verify_phone()
    +update_strength()
    +handle_register()
  }
  class ForgotPasswordScreen {
    <<screens/forgot_password.py>>
    +send_code()
    +verify_code()
  }
  class ResetPasswordWindow {
    <<screens/reset_password.py>>
    +handle_reset()
  }
  class DigitBoxes {
    +get() str
    +is_complete() bool
    +set_error(on)
  }
  class database_core {
    <<module>>
    +register_user(...) bool
    +login_status(email, password) str
    +ssn_error(role, ssn) str
    +staff_venue_error(venue_id, manager_email) str
    +hash_password(password) str
    +verify_password(password, stored) bool
    +update_password(email, new_password)
    +set_currency(email, currency) bool
    +set_staff_venue(email, venue_id, manager_email) dict
  }
  CreateAccountScreen *-- DigitBoxes : SSN
  LoginScreen ..> ForgotPasswordScreen : opens
  ForgotPasswordScreen ..> ResetPasswordWindow : opens
  LoginScreen ..> database_core : POST /api/auth/login
  CreateAccountScreen ..> database_core : POST /api/users/register
  ResetPasswordWindow ..> database_core : PUT /api/users/password
