@startuml
' Use case diagram: Staff and Admin
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #EEF2F7
  BorderColor #1F3A5F
}
skinparam actorBorderColor #1F3A5F

actor Staff as ST
actor Admin as AD

rectangle "Rihla system" {
  usecase "Sign up with SSN, venue\nand manager email" as S1
  usecase "Check in ticket\n(own venue only)" as S2
  usecase "See today's schedule\nof own venue" as S3
  usecase "Resolve support tickets\nof own venue" as S4
  usecase "Change venue and\nmanager in Settings" as S5
  usecase "Report a problem to admin" as S6
  usecase "List all user accounts" as D1
  usecase "Ban or restore account" as D2
  usecase "Read and resolve reports" as D3
  usecase "List and cancel any booking" as D4
}

ST -- S1
ST -- S2
ST -- S3
ST -- S4
ST -- S5
ST -- S6

D1 -- AD
D2 -- AD
D3 -- AD
D4 -- AD

D2 .> D3 : <<extend>>\n(ban offender)
@enduml
