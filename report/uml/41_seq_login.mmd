%% Sequence diagram: login with ban check
sequenceDiagram
  autonumber
  actor U as User
  participant LS as login screen
  participant AC as api_client
  participant SV as server.py
  participant DC as database_core
  participant DB as users.db
  participant RT as routing.py
  U->>LS: email and password, Sign In
  LS->>AC: login(email, password)
  AC->>SV: POST /api/auth/login
  SV->>DC: login_status(email, password)
  DC->>DB: SELECT email, password, banned
  DC->>DC: verify_password (PBKDF2)
  alt wrong email or password
    SV-->>LS: 401 Invalid email or password
  else banned
    SV-->>LS: 403 banned by an administrator
  else ok
    opt old plain text password
      DC->>DB: UPDATE users SET password = hash
    end
    SV-->>AC: email and role
    LS->>RT: show_welcome_screen(email)
    RT->>AC: get_role(email)
    RT-->>U: home screen of that role
  end
