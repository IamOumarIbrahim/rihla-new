// EER diagram of server/users.db in Chen notation.
// Rectangles: entities. Diamonds: relationships. Ovals: attributes.
// Underlined: key. Double oval: multi-valued. Dashed oval: derived (worked out, not stored).
// Double line: total participation. Circle with d: disjoint, total specialization (one role per user).
// Grey entities are shown in full in another part of the diagram.
// Part: Users and roles
graph EER {
  layout=dot; rankdir=LR; nodesep=0.15; ranksep=0.45; splines=true; outputorder=edgesfirst; newrank=true;
  node [fontname="Helvetica", fontsize=16];
  edge [fontname="Helvetica", fontsize=15, color="#2C3E50"];
  USER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  USER__email [shape=ellipse, label=<<U>email</U>>];
  USER -- USER__email;
  USER__password [shape=ellipse, label="password"];
  USER -- USER__password;
  USER__role [shape=ellipse, label="role"];
  USER -- USER__role;
  USER__phone [shape=ellipse, label="phone"];
  USER -- USER__phone;
  USER__currency [shape=ellipse, label="currency"];
  USER -- USER__currency;
  USER__created_at [shape=ellipse, label="created_at"];
  USER -- USER__created_at;
  USER__banned [shape=ellipse, label="banned"];
  USER -- USER__banned;
  USER__banned_at [shape=ellipse, label="banned_at"];
  USER -- USER__banned_at;
  USER__account_age [shape=ellipse, label="account_age", style="dashed"];
  USER -- USER__account_age;
  CUSTOMER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  SSN_HOLDER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  SSN_HOLDER__ssn_hash [shape=ellipse, label="ssn_hash"];
  SSN_HOLDER -- SSN_HOLDER__ssn_hash;
  SSN_HOLDER__ssn_last4 [shape=ellipse, label="ssn_last4"];
  SSN_HOLDER -- SSN_HOLDER__ssn_last4;
  VENDOR [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  STAFF [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  STAFF__manager_email [shape=ellipse, label="manager_email"];
  STAFF -- STAFF__manager_email;
  PARTNER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  DISPATCHER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  ADMIN [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  VENUE [shape=box, style="filled", fillcolor="#ECEFF1", color="#7F8C8D", fontsize=18];
  R_WORKS_AT [shape=diamond, style=filled, fillcolor="#F9E4B7", label="WORKS_AT", fontsize=14];
  R_WORKS_AT -- STAFF [label="N", color="black:white:black"];
  R_WORKS_AT -- VENUE [label="1"];
  R_BANS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="BANS", fontsize=14];
  R_BANS -- ADMIN [label="1"];
  R_BANS -- USER [label="N"];
  spec_role [shape=circle, label="d", width=0.35, fixedsize=true];
  USER -- spec_role [color="black:white:black"];
  spec_role -- CUSTOMER [label="⊃", fontsize=18];
  spec_role -- SSN_HOLDER [label="⊃", fontsize=18];
  spec_ssn [shape=circle, label="d", width=0.35, fixedsize=true];
  SSN_HOLDER -- spec_ssn [color="black:white:black"];
  spec_ssn -- VENDOR [label="⊃", fontsize=18];
  spec_ssn -- STAFF [label="⊃", fontsize=18];
  spec_ssn -- PARTNER [label="⊃", fontsize=18];
  spec_ssn -- DISPATCHER [label="⊃", fontsize=18];
  spec_ssn -- ADMIN [label="⊃", fontsize=18];
}
