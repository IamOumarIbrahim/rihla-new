%% Activity diagram: refund decision in _cancel()
flowchart TD
  S([Cancel request]) --> R{Vendor or admin?}
  R -- yes --> RS{Reason given?}
  RS -- no --> X1([Refuse: reason required])
  RS -- yes --> ST
  R -- no --> ST{Actor allowed and booking Confirmed?}
  ST -- no --> X2([Refuse])
  ST -- yes --> STARTED{Event already started?}
  STARTED -- yes --> X3([Refuse: already started])
  STARTED -- no --> OP{Vendor or admin?}
  OP -- yes --> P100[percent = 100]
  OP -- no --> H{Hours left before start}
  H -- "48 or more" --> P100
  H -- "24 to 48" --> P50[percent = 50]
  H -- "under 24" --> X4([Refuse: closes 24 h before])
  P100 --> T{Ticket still Valid?}
  P50 --> T
  T -- no --> X5([Refuse: ticket already used])
  T -- yes --> SP["split_refund(): refund = total x percent, base = refund / 1.05"]
  SP --> SAVE[Save Cancelled, who, when, role, reason, refund]
  SAVE --> E([Seats are free, refund recorded])
