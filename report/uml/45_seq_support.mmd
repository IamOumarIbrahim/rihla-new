%% Sequence diagram: support ticket from customer to venue staff
sequenceDiagram
  autonumber
  actor C as Customer
  actor S as Staff
  participant CW as Customer Support page
  participant SW as Staff Support Tickets page
  participant SV as server.py
  participant DC as database_core
  participant DB as users.db
  C->>CW: pick event, subject, message, Send
  CW->>SV: POST /api/support
  SV->>SV: _blocked(customer_email)
  SV->>DC: create_support_ticket()
  DC->>DB: event exists or was booked, under 3 open
  DC->>DB: INSERT support_tickets (Open)
  S->>SW: open Support Tickets
  SW->>SV: GET /api/support/open?staff_email=
  SV->>DC: get_staff_support_tickets(staff)
  DC->>DB: open tickets for events at the staff venue
  SV-->>SW: list
  S->>SW: Resolve
  SW->>SV: POST /api/support/{id}/resolve
  SV->>DC: staff_resolve_support_ticket(id, staff)
  DC->>DB: UPDATE status = Resolved (only for that venue)
  CW-->>C: ticket shows Resolved
