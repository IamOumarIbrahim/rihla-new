%% Activity diagram: staff check-in at the venue
flowchart TD
  A([Staff opens Venue Operations]) --> B[Server finds staff venue]
  B --> C{Staff at a venue and not banned?}
  C -- no --> D([Refused])
  C -- yes --> E[Show venue, manager and today's schedule]
  E --> F[Type 16-digit code and Validate]
  F --> G{Ticket exists?}
  G -- no --> H[Invalid ticket code]
  G -- yes --> I{Event at this venue?}
  I -- no --> J[Not for an event at your venue]
  I -- yes --> K{Ticket Valid?}
  K -- no --> L[Cancelled or already used]
  K -- yes --> M[Set ticket Used]
  M --> N[Access granted, admit N guests]
  H --> F
  J --> F
  L --> F
  N --> O([Schedule shows one more check-in])
