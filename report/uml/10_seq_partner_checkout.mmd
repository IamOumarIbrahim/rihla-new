%% Sequence diagram: partner pays the whole shopping list at once
sequenceDiagram
  autonumber
  actor P as Partner
  participant PW as Partner Shopping List
  participant PM as payment.py
  participant AC as api_client
  participant SV as server.py
  participant DE as database_events
  participant DB as users.db
  P->>PW: open Shopping List
  PW->>AC: get_cart_items(email)
  AC->>SV: GET /api/cart/{email}
  SV-->>PW: items with base prices
  P->>PW: Pay all
  PW->>PM: show_demo_payment_modal(items, sum)
  P->>PM: Pay (demo details)
  PM->>AC: checkout_cart(email)
  AC->>SV: POST /api/cart/{email}/checkout
  SV->>SV: _blocked(email, Partner)
  SV->>DE: checkout_cart(email)
  DE->>DB: BEGIN IMMEDIATE
  loop each cart item
    DE->>DE: _book(conn, ..., is_partner=True)
  end
  alt one item fails
    DE->>DB: rollback, no booking kept
    DE-->>PM: error, no booking was made
  else all items succeed
    DE->>DB: commit, then clear cart
    DE-->>PM: list of bookings
    PM-->>P: Booking Details window for all events
  end
