%% Sequence diagram: forgot password
sequenceDiagram
  autonumber
  actor U as User
  participant FP as forgot_password screen
  participant RP as reset_password window
  participant AC as api_client
  participant SV as server.py
  participant DC as database_core
  U->>FP: registered email, Send Code
  FP->>AC: email_exists(email)
  AC->>SV: GET /api/users/email_exists/{email}
  SV-->>FP: exists
  FP-->>U: enter the 6-digit code
  U->>FP: 000000, Verify Code
  FP->>RP: open reset window
  U->>RP: new password twice
  RP->>RP: same, at least 8 characters
  RP->>AC: update_password(email, new)
  AC->>SV: PUT /api/users/password
  SV->>DC: update_password() stores a new hash
  RP-->>U: login screen with the email filled in
