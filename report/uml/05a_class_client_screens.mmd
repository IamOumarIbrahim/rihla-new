%% Design class diagram, part 1: client screens (src/welcome)
classDiagram
  direction TB
  class BaseWelcomeScreen {
    +root
    +email
    +role_name
    +setup_nav_bar()
    +add_nav_button(text, command, icon)
    +setup_scrollable_right_area()
    +open_settings_modal()
    +open_report_page()
  }
  class CustomerWelcomeScreen {
    +all_tours
    +build_customer_content(tours)
    +build_bookings_content()
    +build_experiences_content()
    +build_support_content()
    +handle_cancel_booking(booking)
    +apply_all_filters()
  }
  class VendorWelcomeScreen {
    +build_vendor_content()
    +build_bookings_content()
    +build_venues_content()
    +build_categories_content()
    +open_event_form(title, event)
  }
  class StaffWelcomeScreen {
    +build_operations_content()
    +build_checkin_card(venue)
    +render_today_schedule()
    +handle_resolve_ticket(id)
  }
  class PartnerWelcomeScreen {
    +build_explore_content()
    +build_shopping_list_content()
    +build_bookings_content()
    +handle_cancel(booking)
  }
  class DispatcherWelcomeScreen {
    +vehicle_view
    +dispatch_view
  }
  class AdminWelcomeScreen {
    +build_users_content()
    +build_reports_content()
    +build_bookings_content()
  }
  class VehicleView {
    +build_register_content()
    +build_fleet_management_content()
    +handle_status(status)
  }
  class DispatchView {
    +build_dispatch_content()
  }
  class ReportView {
    +build_report_content()
  }
  BaseWelcomeScreen <|-- CustomerWelcomeScreen
  BaseWelcomeScreen <|-- VendorWelcomeScreen
  BaseWelcomeScreen <|-- StaffWelcomeScreen
  BaseWelcomeScreen <|-- PartnerWelcomeScreen
  BaseWelcomeScreen <|-- DispatcherWelcomeScreen
  BaseWelcomeScreen <|-- AdminWelcomeScreen
  BaseWelcomeScreen ..> ReportView : opens
  DispatcherWelcomeScreen *-- VehicleView
  DispatcherWelcomeScreen *-- DispatchView
