%% Sequence diagram: booker cancels a booking and gets a refund
sequenceDiagram
  autonumber
  actor U as Customer or Partner
  participant UI as My Bookings screen
  participant CA as cancellation.py
  participant AC as api_client
  participant SV as server.py
  participant DE as database_events
  participant DB as users.db
  U->>UI: Cancel booking
  UI->>CA: confirm_own_cancel(booking)
  CA-->>U: shows refund percent and amount
  U->>CA: confirm
  CA->>AC: cancel_booking(id, email)
  AC->>SV: POST /api/bookings/{id}/cancel
  SV->>SV: _blocked(email)
  SV->>DE: cancel_booking(id, email)
  DE->>DB: BEGIN IMMEDIATE, read booking
  DE->>DE: owner check, status must be Confirmed
  DE->>DE: refund_percent_for(start)
  alt 48 h or more before start
    DE->>DE: percent = 100
  else 24 h to 48 h before start
    DE->>DE: percent = 50
  else less than 24 h
    DE-->>U: refused, cancellations close 24 hours before
  end
  DE->>DB: UPDATE tickets SET status = Cancelled WHERE status = Valid
  alt ticket was already used
    DE-->>U: refused
  else ticket was Valid
    DE->>DE: split_refund(total, percent)
    DE->>DB: UPDATE bookings (Cancelled, who, when, reason, refund)
    DE-->>SV: refund base, VAT, total
    SV-->>UI: success message
    UI-->>U: list refreshed, seats are free again
  end
