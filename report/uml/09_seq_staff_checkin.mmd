%% Sequence diagram: staff checks a ticket in (venue scoped)
sequenceDiagram
  autonumber
  actor S as Staff
  participant VO as Venue Operations screen
  participant AC as api_client
  participant SV as server.py
  participant DE as database_events
  participant DC as database_core
  participant DB as users.db
  S->>VO: type 16-digit code, Validate
  VO->>AC: verify_ticket_code(code, event, staff_email)
  AC->>SV: POST /api/tickets/verify
  SV->>DE: staff_verify_ticket(staff_email, code)
  DE->>DC: get_staff_venue(staff_email)
  alt not staff, banned or no venue
    DE-->>VO: refused
  else staff with a venue
    DE->>DB: find ticket and the venue of its event
    alt unknown code
      DE-->>VO: Invalid ticket code
    else ticket for another venue
      DE-->>VO: not for an event at your venue
    else Cancelled or Used
      DE-->>VO: entry refused
    else Valid
      DE->>DB: UPDATE tickets SET status = Used WHERE status = Valid
      DE-->>VO: access granted, admit N guests
    end
  end
  VO-->>S: show result
