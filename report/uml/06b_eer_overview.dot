// EER diagram of server/users.db in Chen notation.
// Rectangles: entities. Diamonds: relationships. Ovals: attributes.
// Underlined: key. Double oval: multi-valued. Dashed oval: derived (worked out, not stored).
// Double line: total participation. Circle with d: disjoint, total specialization (one role per user).
// Grey entities are shown in full in another part of the diagram.
// Part: Overview (no attributes)
graph EER {
  layout=neato; overlap=prism; sep="+6"; splines=true; outputorder=edgesfirst; newrank=true;
  node [fontname="Helvetica", fontsize=26];
  edge [fontname="Helvetica", fontsize=26, color="#2C3E50"];
  USER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  CUSTOMER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  SSN_HOLDER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  VENDOR [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  STAFF [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  PARTNER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  DISPATCHER [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  ADMIN [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  VENUE [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  EVENT [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  VENDOR_CATEGORY [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  BOOKING [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  TICKET [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  REVIEW [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  SUPPORT_TICKET [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  REPORT [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  VEHICLE_TYPE [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  VEHICLE [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  CART_ITEM [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=30];
  R_OWNS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="OWNS", fontsize=24];
  R_OWNS -- VENDOR [label="1"];
  R_OWNS -- VENUE [label="N", color="black:white:black"];
  R_CREATES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="CREATES", fontsize=24];
  R_CREATES -- VENDOR [label="1"];
  R_CREATES -- EVENT [label="N", color="black:white:black"];
  R_DEFINES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="DEFINES", fontsize=24];
  R_DEFINES -- VENDOR [label="1"];
  R_DEFINES -- VENDOR_CATEGORY [label="N", color="black:white:black"];
  R_WORKS_AT [shape=diamond, style=filled, fillcolor="#F9E4B7", label="WORKS_AT", fontsize=24];
  R_WORKS_AT -- STAFF [label="N", color="black:white:black"];
  R_WORKS_AT -- VENUE [label="1"];
  R_HOSTS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="HOSTS", fontsize=24];
  R_HOSTS -- VENUE [label="1"];
  R_HOSTS -- EVENT [label="N", color="black:white:black"];
  R_MAKES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="MAKES", fontsize=24];
  R_MAKES -- USER [label="1"];
  R_MAKES -- BOOKING [label="N", color="black:white:black"];
  R_BOOKED_FOR [shape=diamond, style=filled, fillcolor="#F9E4B7", label="BOOKED_FOR", fontsize=24];
  R_BOOKED_FOR -- EVENT [label="1"];
  R_BOOKED_FOR -- BOOKING [label="N"];
  R_CANCELS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="CANCELS", fontsize=24];
  R_CANCELS -- USER [label="1"];
  R_CANCELS -- BOOKING [label="N"];
  R_HAS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="HAS", fontsize=24];
  R_HAS -- BOOKING [label="1", color="black:white:black"];
  R_HAS -- TICKET [label="1"];
  R_RATES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="RATES", fontsize=24];
  R_RATES -- BOOKING [label="1"];
  R_RATES -- REVIEW [label="1", color="black:white:black"];
  R_OPENS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="OPENS", fontsize=24];
  R_OPENS -- USER [label="1"];
  R_OPENS -- SUPPORT_TICKET [label="N", color="black:white:black"];
  R_ASKS_ABOUT [shape=diamond, style=filled, fillcolor="#F9E4B7", label="ASKS_ABOUT", fontsize=24];
  R_ASKS_ABOUT -- SUPPORT_TICKET [label="N"];
  R_ASKS_ABOUT -- EVENT [label="1"];
  R_RESOLVES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="RESOLVES", fontsize=24];
  R_RESOLVES -- STAFF [label="1"];
  R_RESOLVES -- SUPPORT_TICKET [label="N"];
  R_FILES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="FILES", fontsize=24];
  R_FILES -- USER [label="1"];
  R_FILES -- REPORT [label="N", color="black:white:black"];
  R_CONCERNS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="CONCERNS", fontsize=24];
  R_CONCERNS -- REPORT [label="N"];
  R_CONCERNS -- USER [label="1"];
  R_HANDLES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="HANDLES", fontsize=24];
  R_HANDLES -- ADMIN [label="1"];
  R_HANDLES -- REPORT [label="N"];
  R_BANS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="BANS", fontsize=24];
  R_BANS -- ADMIN [label="1"];
  R_BANS -- USER [label="N"];
  R_REGISTERS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="REGISTERS", fontsize=24];
  R_REGISTERS -- DISPATCHER [label="1"];
  R_REGISTERS -- VEHICLE [label="N", color="black:white:black"];
  R_OF_TYPE [shape=diamond, style=filled, fillcolor="#F9E4B7", label="OF_TYPE", fontsize=24];
  R_OF_TYPE -- VEHICLE_TYPE [label="1"];
  R_OF_TYPE -- VEHICLE [label="N", color="black:white:black"];
  R_ASSIGNED_TO [shape=diamond, style=filled, fillcolor="#F9E4B7", label="ASSIGNED_TO", fontsize=24];
  R_ASSIGNED_TO -- EVENT [label="M"];
  R_ASSIGNED_TO -- VEHICLE [label="N"];
  R_ASSIGNED_TO__status [shape=ellipse, label="status"];
  R_ASSIGNED_TO -- R_ASSIGNED_TO__status;
  R_PLANS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="PLANS", fontsize=24];
  R_PLANS -- PARTNER [label="1"];
  R_PLANS -- CART_ITEM [label="N", color="black:white:black"];
  R_LISTS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="LISTS", fontsize=24];
  R_LISTS -- EVENT [label="1"];
  R_LISTS -- CART_ITEM [label="N", color="black:white:black"];
  spec_role [shape=circle, label="d", width=0.6, fixedsize=true];
  USER -- spec_role [color="black:white:black"];
  spec_role -- CUSTOMER [label="⊃", fontsize=30];
  spec_role -- SSN_HOLDER [label="⊃", fontsize=30];
  spec_ssn [shape=circle, label="d", width=0.6, fixedsize=true];
  SSN_HOLDER -- spec_ssn [color="black:white:black"];
  spec_ssn -- VENDOR [label="⊃", fontsize=30];
  spec_ssn -- STAFF [label="⊃", fontsize=30];
  spec_ssn -- PARTNER [label="⊃", fontsize=30];
  spec_ssn -- DISPATCHER [label="⊃", fontsize=30];
  spec_ssn -- ADMIN [label="⊃", fontsize=30];
}
