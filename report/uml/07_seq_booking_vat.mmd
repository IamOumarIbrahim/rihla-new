%% Sequence diagram: customer books an event and pays (VAT and currency)
sequenceDiagram
  autonumber
  actor C as Customer
  participant ES as event_screen
  participant PM as payment.py
  participant PR as pricing.py
  participant AC as api_client
  participant SV as server.py
  participant DE as database_events
  participant DB as users.db
  C->>ES: choose date and guests
  ES->>AC: get_event_capacity(event_id, date)
  AC->>SV: GET /api/events/{id}/capacity?date=
  SV->>DE: get_event_capacity()
  DE->>DB: vehicle seats or event capacity, minus booked guests
  DE-->>ES: total, booked, remaining
  C->>ES: Proceed to Booking
  ES->>PM: show_demo_payment_modal(items, base AED)
  PM->>PR: vat_breakdown(base)
  PR-->>PM: base, VAT 5%, total
  C->>PM: pick currency and method, press Pay
  PM->>PM: verify_demo_payment(method, details)
  alt details changed
    PM-->>C: "Payment declined" shown in window
  else details match demo records
    PM->>AC: create_booking(email, event, date, guests)
    AC->>SV: POST /api/bookings
    SV->>SV: _blocked(email)
    SV->>DE: create_booking(..., is_partner from role)
    DE->>DB: BEGIN IMMEDIATE
    DE->>DE: check date, guests, capacity
    DE->>DE: add_vat(price x guests)
    DE->>DB: INSERT tickets (16-digit code, Valid)
    DE->>DB: INSERT bookings (total incl. VAT, Confirmed)
    DE-->>SV: booking
    SV-->>AC: 200 success
    AC-->>PM: booking
    PM-->>C: Booking Details window
    opt Download PDF
      PM->>PM: booking_pdf.save_pdf() to Downloads
    end
  end
