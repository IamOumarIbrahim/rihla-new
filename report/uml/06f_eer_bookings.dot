// EER diagram of server/users.db in Chen notation.
// Rectangles: entities. Diamonds: relationships. Ovals: attributes.
// Underlined: key. Double oval: multi-valued. Dashed oval: derived (worked out, not stored).
// Double line: total participation. Circle with d: disjoint, total specialization (one role per user).
// Grey entities are shown in full in another part of the diagram.
// Part: Bookings, tickets, reviews and the partner cart
graph EER {
  layout=dot; rankdir=LR; nodesep=0.15; ranksep=0.45; splines=true; outputorder=edgesfirst; newrank=true;
  node [fontname="Helvetica", fontsize=16];
  edge [fontname="Helvetica", fontsize=15, color="#2C3E50"];
  BOOKING [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  BOOKING__id [shape=ellipse, label=<<U>id</U>>];
  BOOKING -- BOOKING__id;
  BOOKING__booking_date [shape=ellipse, label="booking_date"];
  BOOKING -- BOOKING__booking_date;
  BOOKING__event_time [shape=ellipse, label="event_time"];
  BOOKING -- BOOKING__event_time;
  BOOKING__guests [shape=ellipse, label="guests"];
  BOOKING -- BOOKING__guests;
  BOOKING__total_price [shape=ellipse, label="total_price"];
  BOOKING -- BOOKING__total_price;
  BOOKING__status [shape=ellipse, label="status"];
  BOOKING -- BOOKING__status;
  BOOKING__client_name [shape=ellipse, label="client_name"];
  BOOKING -- BOOKING__client_name;
  BOOKING__created_at [shape=ellipse, label="created_at"];
  BOOKING -- BOOKING__created_at;
  BOOKING__cancelled_at [shape=ellipse, label="cancelled_at"];
  BOOKING -- BOOKING__cancelled_at;
  BOOKING__cancelled_by_role [shape=ellipse, label="cancelled_by_role"];
  BOOKING -- BOOKING__cancelled_by_role;
  BOOKING__cancel_reason [shape=ellipse, label="cancel_reason"];
  BOOKING -- BOOKING__cancel_reason;
  BOOKING__refund_percent [shape=ellipse, label="refund_percent"];
  BOOKING -- BOOKING__refund_percent;
  BOOKING__refund_amount [shape=ellipse, label="refund_amount"];
  BOOKING -- BOOKING__refund_amount;
  BOOKING__shown_status [shape=ellipse, label="shown_status", style="dashed"];
  BOOKING -- BOOKING__shown_status;
  TICKET [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  TICKET__id [shape=ellipse, label=<<U>id</U>>];
  TICKET -- TICKET__id;
  TICKET__ticket_code [shape=ellipse, label="ticket_code"];
  TICKET -- TICKET__ticket_code;
  TICKET__status [shape=ellipse, label="status"];
  TICKET -- TICKET__status;
  REVIEW [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  REVIEW__id [shape=ellipse, label=<<U>id</U>>];
  REVIEW -- REVIEW__id;
  REVIEW__rating [shape=ellipse, label="rating"];
  REVIEW -- REVIEW__rating;
  REVIEW__comment [shape=ellipse, label="comment"];
  REVIEW -- REVIEW__comment;
  REVIEW__created_at [shape=ellipse, label="created_at"];
  REVIEW -- REVIEW__created_at;
  REVIEW__updated_at [shape=ellipse, label="updated_at"];
  REVIEW -- REVIEW__updated_at;
  CART_ITEM [shape=box, style="filled,bold", fillcolor="#D6E4F0", fontsize=18];
  CART_ITEM__id [shape=ellipse, label=<<U>id</U>>];
  CART_ITEM -- CART_ITEM__id;
  CART_ITEM__booking_date [shape=ellipse, label="booking_date"];
  CART_ITEM -- CART_ITEM__booking_date;
  CART_ITEM__guests [shape=ellipse, label="guests"];
  CART_ITEM -- CART_ITEM__guests;
  CART_ITEM__client_name [shape=ellipse, label="client_name"];
  CART_ITEM -- CART_ITEM__client_name;
  CART_ITEM__created_at [shape=ellipse, label="created_at"];
  CART_ITEM -- CART_ITEM__created_at;
  USER [shape=box, style="filled", fillcolor="#ECEFF1", color="#7F8C8D", fontsize=18];
  EVENT [shape=box, style="filled", fillcolor="#ECEFF1", color="#7F8C8D", fontsize=18];
  PARTNER [shape=box, style="filled", fillcolor="#ECEFF1", color="#7F8C8D", fontsize=18];
  R_MAKES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="MAKES", fontsize=14];
  R_MAKES -- USER [label="1"];
  R_MAKES -- BOOKING [label="N", color="black:white:black"];
  R_BOOKED_FOR [shape=diamond, style=filled, fillcolor="#F9E4B7", label="BOOKED_FOR", fontsize=14];
  R_BOOKED_FOR -- EVENT [label="1"];
  R_BOOKED_FOR -- BOOKING [label="N"];
  R_CANCELS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="CANCELS", fontsize=14];
  R_CANCELS -- USER [label="1"];
  R_CANCELS -- BOOKING [label="N"];
  R_HAS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="HAS", fontsize=14];
  R_HAS -- BOOKING [label="1", color="black:white:black"];
  R_HAS -- TICKET [label="1"];
  R_RATES [shape=diamond, style=filled, fillcolor="#F9E4B7", label="RATES", fontsize=14];
  R_RATES -- BOOKING [label="1"];
  R_RATES -- REVIEW [label="1", color="black:white:black"];
  R_PLANS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="PLANS", fontsize=14];
  R_PLANS -- PARTNER [label="1"];
  R_PLANS -- CART_ITEM [label="N", color="black:white:black"];
  R_LISTS [shape=diamond, style=filled, fillcolor="#F9E4B7", label="LISTS", fontsize=14];
  R_LISTS -- EVENT [label="1"];
  R_LISTS -- CART_ITEM [label="N", color="black:white:black"];
}
