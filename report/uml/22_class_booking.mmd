%% Component class diagram: Booking and Shopping List
classDiagram
  direction TB
  class BaseWelcomeScreen
  class CustomerWelcomeScreen {
    +all_tours
    +build_customer_content(tours)
    +build_bookings_content()
    +apply_all_filters()
    +open_filter_modal()
  }
  class PartnerWelcomeScreen {
    +build_explore_content()
    +build_shopping_list_content()
    +build_bookings_content()
    +handle_remove_cart_item(id)
    +handle_clear_cart()
  }
  class EventScreen {
    <<screens/event_screen.py>>
    +show_event_screen(root, email, tour, is_partner)
    +refresh_capacity()
    +draw_calendar()
    +handle_booking()
    +handle_add_to_cart()
  }
  class CapacityBar {
    +set_capacity(remaining, total)
  }
  class database_events {
    <<module>>
    +create_booking(...) dict
    +_book(conn, ...) dict
    +_event_allows_date(...) bool
    +_capacity_info(conn, event_id, day) dict
    +_new_ticket_code(conn) str
    +add_to_cart(...) dict
    +checkout_cart(partner) dict
    +get_bookings_by_customer(email) list
  }
  BaseWelcomeScreen <|-- CustomerWelcomeScreen
  BaseWelcomeScreen <|-- PartnerWelcomeScreen
  CustomerWelcomeScreen ..> EventScreen : View Details
  PartnerWelcomeScreen ..> EventScreen : View Details
  EventScreen *-- CapacityBar
  EventScreen ..> database_events : via api_client
